{
  "name": "monster-ascii",
  "version": "0.5.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Monstertov",
  "description": "Renderer independent animated ASCII art with solid 3D extrusion and eight rotation modes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monstertov/monster-ascii.git"
  },
  "homepage": "https://github.com/Monstertov/monster-ascii#readme",
  "bugs": {
    "url": "https://github.com/Monstertov/monster-ascii/issues"
  },
  "keywords": ["ascii", "ascii-art", "3d", "animation", "terminal", "zero-dependency"],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/core.js"
    },
    "./web": {
      "types": "./src/web.d.ts",
      "default": "./src/web.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.js"
    }
  },
  "bin": {
    "monster-ascii": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "benchmark": "node scripts/benchmark.js"
  },
  "files": [
    "src",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
